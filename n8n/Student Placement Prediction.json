{
  "name": "Student Placement Prediction",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Student Placement Prediction",
        "formDescription": "Enter the student details to predict placement using the Random Forest model.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "SSC Percentage (ssc_p)",
              "fieldType": "number",
              "fieldName": "ssc_p",
              "placeholder": "e.g. 75.5",
              "requiredField": true
            },
            {
              "fieldLabel": "HSC Percentage (hsc_p)",
              "fieldType": "number",
              "fieldName": "hsc_p",
              "placeholder": "e.g. 75.5",
              "requiredField": true
            },
            {
              "fieldLabel": "Degree Percentage (degree_p)",
              "fieldType": "number",
              "fieldName": "degree_p",
              "placeholder": "e.g. 75.5",
              "requiredField": true
            },
            {
              "fieldLabel": "Work Experience (workex)",
              "fieldType": "dropdown",
              "fieldName": "workex",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes"
                  },
                  {
                    "option": "No"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Employability Test Percentage (etest_p)",
              "fieldType": "number",
              "fieldName": "etest_p",
              "placeholder": "e.g. 75.5",
              "requiredField": true
            },
            {
              "fieldLabel": "MBA Specialisation (specialisation)",
              "fieldType": "dropdown",
              "fieldName": "specialisation",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Mkt&Fin"
                  },
                  {
                    "option": "Mkt&HR"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "MBA Percentage (mba_p)",
              "fieldType": "number",
              "fieldName": "mba_p",
              "placeholder": "e.g. 75.5",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "buttonLabel": "Predict Placement"
